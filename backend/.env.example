# Local environment for running the backend outside Docker.
# Docker Compose sets its own values and needs no .env file.
# Spring Boot does not read this file, so export the values in the shell or load them in the IDE.
# SERVER_PORT is optional and defaults to 8095.

# Connection to the local PostgreSQL 17 instance.
SPRING_DATASOURCE_PASSWORD=<your-string-password>
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/lodwar_ticket_tracker
SPRING_DATASOURCE_USERNAME=postgres

# The local profile activates the Liquibase seed context, which loads forty sample tickets.
SPRING_PROFILES_ACTIVE=local